---
import { Image } from "astro:assets";
import H1 from "../../components/h1.astro";
import InfoLayout from "../../layouts/InfoLayout.astro";
import { projects, tagColors } from "../../data/projects";
---

<InfoLayout>
  <div class="p-4 sm:pt-8 sm:px-12 pb-20 min-h-screen">
    <div class="flex items-start justify-between gap-4 flex-wrap">
      <H1>Mes projets récents</H1>
      <a
        href="/explore"
        class="mt-2 inline-flex items-center gap-2 px-4 py-2 bg-zinc-800 border border-zinc-700 rounded-full text-zinc-300 text-sm hover:text-white hover:bg-zinc-700 transition-colors"
      >
        <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <circle cx="12" cy="12" r="10"/>
          <path d="M12 2a15.3 15.3 0 0 1 4 10 15.3 15.3 0 0 1-4 10 15.3 15.3 0 0 1-4-10 15.3 15.3 0 0 1 4-10z"/>
          <path d="M2 12h20"/>
        </svg>
        Mode exploration 3D
      </a>
    </div>
    <ul class="mt-4 sm:mt-12 grid grid-cols-1 sm:grid-cols-3 gap-16 sm:gap-8">
      {projects.map((project) => (
        <li>
          <a href={`/projects/${project.slug}`} class="block group">
            <Image src={project.image} alt={project.title} class="aspect-[1/1.33] object-center object-cover rounded-lg shadow-md group-hover:opacity-90 transition duration-200" />
            <div class="p-1 sm:p-2">
              <div class="flex flex-wrap gap-1 mb-1">
                {project.tags.map((tag) => (
                  <span class={`text-xs px-2 py-0.5 rounded-full border ${tagColors[tag] || "bg-zinc-500/20 text-zinc-300 border-zinc-500/30"}`}>
                    {tag}
                  </span>
                ))}
              </div>
              <h2 class="text-base text-zinc-100">{project.title}</h2>
              <p class="text-sm text-zinc-400 text-balance">{project.description}</p>
            </div>
          </a>
        </li>
      ))}
    </ul>
  </div>
</InfoLayout>
