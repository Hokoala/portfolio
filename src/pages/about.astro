---
import H1 from "../components/h1.astro";
import InfoLayout from "../layouts/InfoLayout.astro";
import { Icon } from "@iconify/react";
---

<InfoLayout>
  <div class="p-4 sm:pt-8 sm:px-12 pb-20 min-h-screen flex flex-col justify-between gap-16">
    <div class="space-y-4 sm:space-y-12">
      <div class="flex flex-col sm:flex-row items-start gap-8">
        <div class="flex-1">
          <H1>À Propos</H1>
          <p class="text-xl xl:text-2xl text-zinc-500 text-balance mt-4">
            Bonjour, je suis Jean Michel LE, développeur web passionné et futur ingénieur logiciel. Étudiant en MMI (Métiers du Multimédia et de l'Internet), je construis des applications web modernes et des outils qui résolvent de vrais problèmes.
          </p>
        </div>
        <div>
          <img
            src="../assets/Portrait.jpg" alt="PHOTO DE JEAN MICHEL LE"
            class="w-80 h-auto object-cover border-2 border-zinc-600 shadow"
          />
        </div>
      </div>
    </div>

    <!-- Compétences techniques -->
    <div class="space-y-8">
      <h2 class="px-4 text-zinc-400 underline underline-offset-4 decoration-zinc-500">Compétences techniques</h2>

      <!-- Frontend -->
      <div class="space-y-2">
        <p class="px-4 text-zinc-500 text-xs uppercase tracking-widest">Frontend</p>
        <div class="px-4 py-6 rounded-2xl border border-zinc-800 bg-gradient-to-r from-zinc-900 to-black/70 shadow-inner">
          <ul class="text-zinc-400 flex flex-wrap gap-6 justify-start items-center">
            <li><Icon icon="logos:react" width="50" height="50" title="React" client:only="react" /></li>
            <li><Icon icon="logos:nextjs-icon" width="50" height="50" title="Next.js" client:only="react" /></li>
            <li><Icon icon="logos:vue" width="50" height="50" title="Vue.js" client:only="react" /></li>
            <li><Icon icon="logos:nuxt-icon" width="50" height="50" title="Nuxt.js" client:only="react" /></li>
            <li><Icon icon="simple-icons:astro" width="50" height="50" color="white" title="Astro" client:only="react" /></li>
            <li><Icon icon="logos:typescript-icon" width="50" height="50" title="TypeScript" client:only="react" /></li>
            <li><Icon icon="logos:tailwindcss-icon" width="50" height="50" title="Tailwind CSS" client:only="react" /></li>
          </ul>
        </div>
      </div>

      <!-- Backend & Base de données -->
      <div class="space-y-2">
        <p class="px-4 text-zinc-500 text-xs uppercase tracking-widest">Backend & Base de données</p>
        <div class="px-4 py-6 rounded-2xl border border-zinc-800 bg-gradient-to-r from-zinc-900 to-black/70 shadow-inner">
          <ul class="text-zinc-400 flex flex-wrap gap-6 justify-start items-center">
            <li><Icon icon="logos:nodejs-icon" width="50" height="50" title="Node.js" client:only="react" /></li>
            <li><Icon icon="logos:python" width="50" height="50" title="Python" client:only="react" /></li>
            <li><Icon icon="logos:postgresql" width="50" height="50" title="PostgreSQL" client:only="react" /></li>
            <li><Icon icon="simple-icons:prisma" width="50" height="50" color="white" title="Prisma" client:only="react" /></li>
          </ul>
        </div>
      </div>

      <!-- Outils -->
      <div class="space-y-2">
        <p class="px-4 text-zinc-500 text-xs uppercase tracking-widest">Outils & DevOps</p>
        <div class="px-4 py-6 rounded-2xl border border-zinc-800 bg-gradient-to-r from-zinc-900 to-black/70 shadow-inner">
          <ul class="text-zinc-400 flex flex-wrap gap-6 justify-start items-center">
            <li><Icon icon="logos:git-icon" width="50" height="50" title="Git" client:only="react" /></li>
            <li><Icon icon="logos:docker-icon" width="50" height="50" title="Docker" client:only="react" /></li>
            <li><Icon icon="logos:figma" width="50" height="50" title="Figma" client:only="react" /></li>
          </ul>
        </div>
      </div>
    </div>
  </div>
</InfoLayout>
