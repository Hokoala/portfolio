---
import { Image } from "astro:assets";
import H1 from "../components/h1.astro";
import InfoLayout from "../layouts/InfoLayout.astro";
import type { link } from "motion/react-client";
import Kenzo from "../assets/kenzo.png";
import Utopia from "../assets/utopia.png";
import Sae202 from "../assets/sae202.jpg";
import Unity from "../assets/Mockup_unity.jpg";
import Tree from "../assets/Mockup_tree.js.png";
import Michel from "../assets/Michel-et-l’Anneau.png";
import  BookGraphique from "../assets/BookGraphique.png";
import Spotify from "../assets/spotify.png";
import SiteMomentum from "../assets/SiteMomentum.png";
import AppFilm from "../assets/APP-Movie.png";
import DraftAI from "../assets/DraftAI.png";

const projects = [
    {
        title: "Draft AI",
        description: "Draft AI est une application SaaS (Software as a Service) qui permet aux freelances et créateurs de contenu de transformer des notes brutes en contenu structuré grâce à l'intelligence artificielle.",
        image: DraftAI,
        link: "https://sass-draft-ai.vercel.app/"
    },
    {
        title: "Site Momentum",
        description: "Développement d’une plateforme web connectée à une API pour le jeu de parkour sur borne d’arcade MOMENTUM.",
        image: SiteMomentum,
        link: "https://momentum.mmi23f03.fr/"
    },
    {
        title: "Api Spotify",
        description: "Projet d'intégration de l'API Spotify pour créer une application web permettant aux utilisateurs de rechercher des artistes, des albums et des playlists, et d'écouter des extraits musicaux.",
        image: Spotify,
        link: "https://api-spotify-zeta.vercel.app/dashboard"
    },
    {
        title: "Application Films Séries",
        description: "Découvre et parcoure facilement des films et séries grâce à cette application web, développée avec Nuxt.js et Vue.js, et intégrant une API.",
        image: AppFilm,
        link: "https://github.com/Hokoala/Projet_film"
    },
  {
    title: "ANIMA",
    description: "Projet de gestion de base de données pour une application web CRUD (Créer, Lire, Mettre à jour, Supprimer), sur le thème de l’animation Disney et DreamWorks.",
    image: Sae202,
    link: "https://mmi23e10.sae203.ovh/"
  },

  {
   title: "Michel et l’Anneau",
   description: "Avec notre equipe nous avons conçu une histoire interactive, intitulée Michel et l’anneau, alliant narration et interactivité pour captiver l’utilisateur.",
   image: Michel,
   link: "https://sae402.beauget.fr/"
     },
  {
     title: "Refont Utopia",
     description: "Refonte complète du site Utopia, de A à Z, avec un focus sur l’ergonomie, l’accessibilité et l’expérience utilisateur.",
     image: Utopia,
     link: "http://mmi23f01.sae301dev.ovh/"
},


  {
    title: "Jeu unity 3D",
    description: "Création d'un jeu 3D avec Unity",
    image: Unity,
    link: "http://mmi23e10.mmi-troyes.fr/wr409"
  },
  {
    title: "Site tree js",
    description: "Création d'un site avec Tree js, au cours de cette expérience, j'ai appris à manipuler des objets 3D et à créer des animations interactives.",
    image: Tree,
    link: "http://mmi23e10.mmi-troyes.fr/wr405d/"
  },

  {
  title: "Book Graphique",
  description: "Voici mon book graphique, une collection de mes travaux récents en design graphique, illustrant ma passion pour l'esthétique et la créativité.",
  image: BookGraphique,
  link: "https://www.linkedin.com/in/jean-michel-le/overlay/1739270714168/single-media-viewer/?profileId=ACoAAEEs1jkB8oZaJ4BYEcU53ccQb6FeJdpMZfE"
},

{
  title: "Publication fictive pour Amara by Kenzo",
  description: "Notre projet de publication fictive pour Amara by Kenzo, mettant en avant des designs innovants et une approche créative.",
  image: Kenzo,
  link: "https://www.youtube.com/watch?v=pBSbaEKWqGo"
},


];

---


<InfoLayout>
  <div class="p-4 sm:pt-8 sm:px-12 pb-20 min-h-screen">
    <H1> Mes projets récents </H1>
    <ul class="mt-4 sm:mt-12 grid grid-cols-1 sm:grid-cols-3 gap-16 sm:gap-8">
      {projects.map((project) => (
        <li>
          <a href={project.link} target="_blank" rel="noopener noreferrer" class="block group">
            <Image src={project.image} alt={project.title} class="aspect-[1/1.33] object-center object-cover rounded-lg shadow-md group-hover:opacity-90 transition duration-200" />
            <div class="p-1 sm:p-2">
              <h2 class="text-base text-zinc-100">{project.title}</h2>
              <p class="text-sm text-zinc-400 text-balance">{project.description}</p>
            </div>
          </a>
        </li>
      ))}
    </ul>
  </div>
</InfoLayout>