---
import H1 from "../components/h1.astro";
import InfoLayout from "../layouts/InfoLayout.astro";
---

<InfoLayout title="Stage — Ransau Systeme">
    <div class="p-4 sm:pt-8 sm:px-12 pb-20 min-h-screen">

        <!-- Back -->
        <a href="/" class="inline-flex items-center gap-2 text-zinc-400 hover:text-zinc-100 transition-colors mb-8 group">
            <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="group-hover:-translate-x-1 transition-transform">
                <path d="m12 19-7-7 7-7"/>
                <path d="M19 12H5"/>
            </svg>
            Retour
        </a>

        <!-- Header -->
        <div class="mb-8 sm:mb-16">
            <p class="text-zinc-500 text-sm uppercase tracking-widest mb-2">Stage entreprise — 2025</p>
            <H1>Ransau<br/>Systeme</H1>
            <p class="mt-4 sm:mt-6 text-zinc-400 max-w-2xl text-base sm:text-lg leading-relaxed">
                Refonte complète de l'interface du site de Ransau Systeme — modernisation du design,
                développement en React et Tailwind CSS, animations 3D et nouveaux composants.
            </p>
        </div>

        <!-- Stats -->
        <div class="flex flex-wrap gap-8 sm:gap-16 mb-12 sm:mb-16 py-6 border-y border-zinc-800">
            <div>
                <p class="text-3xl sm:text-4xl font-bold text-white">2025</p>
                <p class="text-zinc-500 text-sm">Année</p>
            </div>
            <div>
                <p class="text-3xl sm:text-4xl font-bold text-white">React</p>
                <p class="text-zinc-500 text-sm">Stack principal</p>
            </div>
            <div>
                <p class="text-3xl sm:text-4xl font-bold text-white">Refonte</p>
                <p class="text-zinc-500 text-sm">Type de mission</p>
            </div>
        </div>

        <!-- Main Content -->
        <div class="grid grid-cols-1 lg:grid-cols-3 gap-8 lg:gap-16">

            <!-- Left — contenu principal -->
            <div class="lg:col-span-2 space-y-12">

                <!-- Présentation de l'entreprise -->
                <div>
                    <h2 class="text-xl font-semibold text-zinc-100 mb-4">L'entreprise</h2>
                    <p class="text-zinc-400 leading-relaxed">
                        Ransau Systeme est une entreprise spécialisée dans les solutions informatiques et systèmes.
                        Lors de mon stage, j'ai intégré l'équipe avec pour mission principale de moderniser
                        l'interface de leur site existant, qui présentait plusieurs lacunes côté design et expérience utilisateur.
                    </p>
                </div>

                <!-- Missions -->
                <div>
                    <h2 class="text-xl font-semibold text-zinc-100 mb-6">Mes missions</h2>
                    <div class="space-y-4">
                        {[
                            {
                                title: "Audit de l'existant",
                                desc: "Analyse de l'ancien système — identification des problèmes de design, des composants manquants et des incohérences visuelles."
                            },
                            {
                                title: "Refonte du design",
                                desc: "Redesign complet de l'interface : cohérence visuelle, hiérarchie typographique, palette de couleurs et espacement."
                            },
                            {
                                title: "Développement des composants",
                                desc: "Développement en React et Tailwind CSS — boutons, footer, header, cartes, formulaires et tous les composants UI."
                            },
                            {
                                title: "Animations 3D",
                                desc: "Intégration d'animations 3D pour dynamiser l'expérience utilisateur et renforcer l'identité visuelle de l'entreprise."
                            },
                            {
                                title: "Responsive design",
                                desc: "Adaptation de l'ensemble de l'interface pour tous les formats d'écran — mobile, tablette et desktop."
                            },
                        ].map((mission) => (
                            <div class="flex gap-4 p-5 bg-zinc-800/30 border border-zinc-700/50 rounded-xl">
                                <span class="mt-1 w-2 h-2 rounded-full bg-zinc-400 shrink-0"></span>
                                <div>
                                    <p class="text-zinc-100 font-medium mb-1">{mission.title}</p>
                                    <p class="text-zinc-400 text-sm leading-relaxed">{mission.desc}</p>
                                </div>
                            </div>
                        ))}
                    </div>
                </div>

                <!-- Ce que j'ai appris -->
                <div>
                    <h2 class="text-xl font-semibold text-zinc-100 mb-4">Ce que j'ai appris</h2>
                    <p class="text-zinc-400 leading-relaxed">
                        Ce stage m'a permis de travailler sur un projet réel en contexte professionnel —
                        gérer les contraintes d'un existant, communiquer avec une équipe, livrer du code propre
                        et maintenable. J'ai approfondi ma maîtrise de React, Tailwind CSS et des animations 3D
                        tout en développant ma rigueur sur la qualité du design.
                    </p>
                </div>

                <!-- Technologies -->
                <div>
                    <h2 class="text-xl font-semibold text-zinc-100 mb-4">Technologies utilisées</h2>
                    <div class="flex flex-wrap gap-3">
                        {["React", "Tailwind CSS", "Animations 3D", "JavaScript", "HTML/CSS"].map((tech) => (
                            <span class="px-4 py-2 bg-zinc-800/50 border border-zinc-700 rounded-lg text-zinc-300 text-sm">
                                {tech}
                            </span>
                        ))}
                    </div>
                </div>

                <!-- Compétences validées -->
                <div>
                    <h2 class="text-xl font-semibold text-zinc-100 mb-4">Compétences validées</h2>
                    <ul class="space-y-2">
                        {[
                            "Développer — Développement front-end avec React et Tailwind CSS",
                            "Concevoir — Refonte UI/UX d'un système existant",
                            "Concevoir — Intégration d'animations 3D dans une interface web",
                            "Entreprendre — Travail en autonomie dans un contexte professionnel réel",
                        ].map((c) => (
                            <li class="flex items-start gap-3">
                                <span class="mt-1 w-2 h-2 rounded-full bg-zinc-400 shrink-0"></span>
                                <span class="text-zinc-300 text-sm">{c}</span>
                            </li>
                        ))}
                    </ul>
                </div>
            </div>

            <!-- Right — sidebar -->
            <div class="space-y-6">
                <div class="bg-zinc-800/30 border border-zinc-700/50 rounded-2xl p-6 space-y-6">
                    <div>
                        <p class="text-zinc-500 text-sm mb-1">Entreprise</p>
                        <p class="text-zinc-100 font-medium">Ransau Systeme</p>
                    </div>
                    <div>
                        <p class="text-zinc-500 text-sm mb-1">Rôle</p>
                        <p class="text-zinc-100 font-medium">Développeur Front-end stagiaire</p>
                    </div>
                    <div>
                        <p class="text-zinc-500 text-sm mb-1">Durée</p>
                        <p class="text-zinc-100 font-medium">À remplir</p>
                    </div>
                    <div>
                        <p class="text-zinc-500 text-sm mb-1">Année</p>
                        <p class="text-zinc-100 font-medium">2025</p>
                    </div>
                    <div>
                        <p class="text-zinc-500 text-sm mb-1">Type</p>
                        <p class="text-zinc-100 font-medium">Stage obligatoire MMI</p>
                    </div>
                </div>

                <a
                    href="https://www.ransau-systeme.com/"
                    target="_blank"
                    rel="noopener noreferrer"
                    class="flex items-center justify-center gap-2 w-full px-6 py-4 bg-zinc-100 text-zinc-900 rounded-xl font-medium hover:bg-white transition-colors"
                >
                    Voir le site
                    <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                        <path d="M7 17L17 7"/>
                        <path d="M7 7h10v10"/>
                    </svg>
                </a>
            </div>
        </div>

        <!-- CTA -->
        <div class="mt-16 sm:mt-24 pt-8 border-t border-zinc-800">
            <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-4">
                <div>
                    <h3 class="text-zinc-100 text-lg font-medium">Voir mes projets universitaires</h3>
                    <p class="text-zinc-500 text-sm">Mes réalisations dans le cadre de la formation MMI</p>
                </div>
                <a
                    href="/univ"
                    class="inline-flex items-center gap-2 px-6 py-3 bg-zinc-100 text-zinc-900 rounded-full font-medium text-sm hover:bg-white transition-colors"
                >
                    Projets MMI
                    <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                        <path d="M5 12h14"/>
                        <path d="m12 5 7 7-7 7"/>
                    </svg>
                </a>
            </div>
        </div>
    </div>
</InfoLayout>
